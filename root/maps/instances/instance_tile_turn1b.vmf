{
	"id" "870"
	"classname" "trigger_asw_button_area"
	"changepanelskin" "1"
	"DestroyHeldObject" "0"
	"disableafteruse" "0"
	"health" "1"
	"HoldTime" "-1"
	"locked" "0"
	"needstech" "1"
