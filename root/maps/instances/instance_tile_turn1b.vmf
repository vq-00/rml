	"playersrequired" "1"
	"spawnflags" "16"
	"StartDisabled" "0"
	"targetname" "scenery_tile_turn1b"
	"useafterhack" "1"
	"usepanelmessage" "Destroy Power Source"
	"wait" "1"
	"wirecolumns" "5"
	"wirerows" "2"
	connections
	{
		"OnButtonActivated" "counter_powerAdd10-1"
		"OnButtonActivated" "!selfRunScriptCodeEntFireByHandle( Entities.FindByClassnameNearest( `prop_dynamic`, self.GetOrigin() + Vector( 0.0, 0.0, -128.0 ), 512.0 ), `Skin`, `1`, 0.0, null, null )0-1"
		"OnButtonActivated" "!selfRunScriptCodeself.Destroy()0.05-1"
		"OnButtonActivated" "!selfRunScriptCodeEntFireByHandle( Entities.FindByClassnameNearest( `asw_marker`, self.GetOrigin(), 512.0 ), `SetComplete`, ``, 0.0, null, null )0-1"
		"OnButtonActivated" "asw_spawnerRunScriptCodeif ( `ActivateHoldout` in self.GetScriptScope() ){ ActivateHoldout( caller ) }0.05-1"
		"OnButtonActivated" "!selfRunScriptCodeEntities.FindByClassnameNearest( `env_sprite`, self.GetOrigin(), 512.0 ).Destroy()0.05-1"
		"OnButtonActivated" "!selfRunScriptCodeEntities.FindByClassnameNearest( `func_rotating`, self.GetOrigin(), 512.0 ).Destroy()0.05-1"
		"OnButtonActivated" "!selfRunScriptCodeEntities.FindByClassnameNearest( `env_projectedtexture`, self.GetOrigin(), 512.0 ).Destroy()0.05-1"
	}
